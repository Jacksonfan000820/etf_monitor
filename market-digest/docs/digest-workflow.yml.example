# Inactive template. Copy to root .github/workflows/ only after authorization.
# No schedule, no secrets, no send step.
name: Market digest manual dry run
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  digest:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    defaults:
      run:
        working-directory: market-digest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.txt
      - run: python -m unittest discover -s tests -v
      - run: python digest.py
      - uses: actions/upload-artifact@v4
        with:
          name: market-digest-${{ github.run_id }}
          path: market-digest/out/
          retention-days: 7
